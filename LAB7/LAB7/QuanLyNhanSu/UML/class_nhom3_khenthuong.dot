digraph G {
  graph [fontname="Liberation Serif", bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.75, splines=true , rankdir=TB];
  node  [fontname="Liberation Serif", fontsize=11, shape=plaintext, color="#990033"];
  edge  [fontname="Liberation Serif", fontsize=10, color="#990033", fontcolor="#111111", arrowsize=0.8];
  PhongBan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>PhongBan</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaPB</U> : String<BR ALIGN="LEFT"/>TenPB : String<BR ALIGN="LEFT"/>LoaiDonVi : String<BR ALIGN="LEFT"/>DienThoai : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+themPhongBan()<BR ALIGN="LEFT"/>+capNhatPhongBan()<BR ALIGN="LEFT"/>+xoaPhongBan()<BR ALIGN="LEFT"/>+layDanhSach()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  NhanVien [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>NhanVien</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaNV</U> : String<BR ALIGN="LEFT"/>HoTen : String<BR ALIGN="LEFT"/>GioiTinh : String<BR ALIGN="LEFT"/>NgaySinh : Date<BR ALIGN="LEFT"/>CCCD : String<BR ALIGN="LEFT"/>DiaChi : String<BR ALIGN="LEFT"/>DienThoai : String<BR ALIGN="LEFT"/>TrangThai : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+themHoSo()<BR ALIGN="LEFT"/>+capNhatHoSo()<BR ALIGN="LEFT"/>+timKiem(tuKhoa)<BR ALIGN="LEFT"/>+chuyenTrangThai(trangThaiMoi)<BR ALIGN="LEFT"/>+layDangLamViec()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  QuyetDinhKhenThuong [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>QuyetDinhKhenThuong</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>SoQD</U> : String<BR ALIGN="LEFT"/>NgayKy : Date<BR ALIGN="LEFT"/>LoaiKhenThuong : String<BR ALIGN="LEFT"/>DoiTuong : String<BR ALIGN="LEFT"/>NoiDung : String<BR ALIGN="LEFT"/>SoTien : Decimal<BR ALIGN="LEFT"/>HinhThucChi : String<BR ALIGN="LEFT"/>NguoiKy : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+lapQuyetDinh()<BR ALIGN="LEFT"/>+kiemTraDoiTuong()<BR ALIGN="LEFT"/>+tongThuongTrongThang(maNV, thang, nam)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PhieuChiKhenThuong [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>PhieuChiKhenThuong</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>SoPhieuChi</U> : String<BR ALIGN="LEFT"/>NgayChi : Date<BR ALIGN="LEFT"/>SoTien : Decimal<BR ALIGN="LEFT"/>NguoiNhan : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+lapPhieuChi()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  QuyetDinhKyLuat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>QuyetDinhKyLuat</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>SoQD</U> : String<BR ALIGN="LEFT"/>NgayKy : Date<BR ALIGN="LEFT"/>DoiTuong : String<BR ALIGN="LEFT"/>LyDo : String<BR ALIGN="LEFT"/>SoTienPhat : Decimal<BR ALIGN="LEFT"/>HinhThucThu : String<BR ALIGN="LEFT"/>NguoiKy : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+lapQuyetDinh()<BR ALIGN="LEFT"/>+tongPhatTrongThang(maNV, thang, nam)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PhieuThuNopPhat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>PhieuThuNopPhat</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>SoPhieuThu</U> : String<BR ALIGN="LEFT"/>NgayThu : Date<BR ALIGN="LEFT"/>SoTien : Decimal<BR ALIGN="LEFT"/>NguoiNop : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+lapPhieuThu()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  {rank=same; PhongBan; NhanVien;}
  {rank=same; QuyetDinhKhenThuong; QuyetDinhKyLuat;}
  {rank=same; PhieuChiKhenThuong; PhieuThuNopPhat;}
  PhongBan -> NhanVien [arrowhead=vee, taillabel="0..1", headlabel="0..*", label="thuộc"];
  NhanVien -> QuyetDinhKhenThuong [arrowhead=vee, taillabel="0..1", headlabel="0..*", label="cá nhân"];
  PhongBan -> QuyetDinhKhenThuong [arrowhead=vee, taillabel="0..1", headlabel="0..*", label="tập thể"];
  QuyetDinhKhenThuong -> PhieuChiKhenThuong [arrowhead=vee, taillabel="1", headlabel="0..1", label="chi qua"];
  NhanVien -> QuyetDinhKyLuat [arrowhead=vee, taillabel="0..1", headlabel="0..*", label="cá nhân"];
  PhongBan -> QuyetDinhKyLuat [arrowhead=vee, taillabel="0..1", headlabel="0..*", label="tập thể"];
  QuyetDinhKyLuat -> PhieuThuNopPhat [arrowhead=vee, taillabel="1", headlabel="0..1", label="thu qua"];
}
