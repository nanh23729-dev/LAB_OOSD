digraph G {
  graph [fontname="Liberation Serif", bgcolor="white", pad=0.3, nodesep=0.6, ranksep=0.55, splines=true , rankdir=LR];
  node  [fontname="Liberation Serif", fontsize=11, shape=plaintext, color="#990033"];
  edge  [fontname="Liberation Serif", fontsize=10, color="#990033", fontcolor="#111111", arrowsize=0.8];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFCC", fontsize=11, margin="0.15,0.08"];
  start [shape=circle, label="", width=0.22, style=filled, fillcolor=black];
  end1 [shape=doublecircle, label="", width=0.18, style=filled, fillcolor=black];
  HoSo [label=<<B>Hồ sơ</B><BR/><FONT POINT-SIZE="9">entry/ lưu hồ sơ ứng viên</FONT>>];
  ThuViec [label=<<B>Thử việc</B><BR/><FONT POINT-SIZE="9">entry/ lưu QĐ tuyển dụng</FONT>>];
  ChinhThuc [label=<<B>Chính thức</B><BR/><FONT POINT-SIZE="9">entry/ lưu hợp đồng</FONT>>];
  NghiViec [label=<<B>Nghỉ việc</B><BR/><FONT POINT-SIZE="9">entry/ chốt hồ sơ</FONT>>];
  start -> HoSo [label="themHoSo()"];
  HoSo -> ThuViec [label="lapQuyetDinhTuyenDung()"];
  ThuViec -> ChinhThuc [label="kyHopDong()\n[kết quả = Đạt,\nhết thời gian thử việc]"];
  ThuViec -> NghiViec [label="capNhatKetQuaThuViec()\n[Không đạt]"];
  ChinhThuc -> NghiViec [label="chamDutHopDong()", style=dashed];
  NghiViec -> end1;
}
