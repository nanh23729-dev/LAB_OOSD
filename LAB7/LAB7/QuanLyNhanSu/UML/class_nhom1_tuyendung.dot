digraph G {
  graph [fontname="Liberation Serif", bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.75, splines=true , rankdir=TB];
  node  [fontname="Liberation Serif", fontsize=11, shape=plaintext, color="#990033"];
  edge  [fontname="Liberation Serif", fontsize=10, color="#990033", fontcolor="#111111", arrowsize=0.8];
  PhongBan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>PhongBan</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaPB</U> : String<BR ALIGN="LEFT"/>TenPB : String<BR ALIGN="LEFT"/>LoaiDonVi : String<BR ALIGN="LEFT"/>DienThoai : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+themPhongBan()<BR ALIGN="LEFT"/>+capNhatPhongBan()<BR ALIGN="LEFT"/>+xoaPhongBan()<BR ALIGN="LEFT"/>+layDanhSach()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ChucVu [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>ChucVu</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaCV</U> : String<BR ALIGN="LEFT"/>TenCV : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+themChucVu()<BR ALIGN="LEFT"/>+capNhatChucVu()<BR ALIGN="LEFT"/>+xoaChucVu()<BR ALIGN="LEFT"/>+layDanhSach()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  NhanVien [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>NhanVien</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaNV</U> : String<BR ALIGN="LEFT"/>HoTen : String<BR ALIGN="LEFT"/>GioiTinh : String<BR ALIGN="LEFT"/>NgaySinh : Date<BR ALIGN="LEFT"/>CCCD : String<BR ALIGN="LEFT"/>DiaChi : String<BR ALIGN="LEFT"/>DienThoai : String<BR ALIGN="LEFT"/>TrangThai : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+themHoSo()<BR ALIGN="LEFT"/>+capNhatHoSo()<BR ALIGN="LEFT"/>+timKiem(tuKhoa)<BR ALIGN="LEFT"/>+chuyenTrangThai(trangThaiMoi)<BR ALIGN="LEFT"/>+layDangLamViec()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  QuyetDinhTuyenDung [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>QuyetDinhTuyenDung</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>SoQD</U> : String<BR ALIGN="LEFT"/>NgayKy : Date<BR ALIGN="LEFT"/>NgayBatDauThuViec : Date<BR ALIGN="LEFT"/>NgayKetThucThuViec : Date<BR ALIGN="LEFT"/>LuongThuViec : Decimal<BR ALIGN="LEFT"/>DieuKhoan : String<BR ALIGN="LEFT"/>NguoiKy : String<BR ALIGN="LEFT"/>KetQuaThuViec : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+lapQuyetDinh()<BR ALIGN="LEFT"/>+capNhatKetQuaThuViec(ketQua)<BR ALIGN="LEFT"/>+kiemTraHetThuViec(ngay)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  HopDongLaoDong [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>HopDongLaoDong</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>SoHD</U> : String<BR ALIGN="LEFT"/>LoaiHD : String<BR ALIGN="LEFT"/>NgayKy : Date<BR ALIGN="LEFT"/>NgayBatDau : Date<BR ALIGN="LEFT"/>NgayKetThuc : Date<BR ALIGN="LEFT"/>NguoiKy : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+kyHopDong()<BR ALIGN="LEFT"/>+kiemTraDieuKienKy()<BR ALIGN="LEFT"/>+laDaiHan()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  HoSoBaoHiem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>HoSoBaoHiem</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaHSBH</U> : String<BR ALIGN="LEFT"/>SoSoBHXH : String<BR ALIGN="LEFT"/>SoTheBHYT : String<BR ALIGN="LEFT"/>NgayThamGia : Date<BR ALIGN="LEFT"/>TyLeBHXH : Decimal<BR ALIGN="LEFT"/>TyLeBHYT : Decimal<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+lapHoSo()<BR ALIGN="LEFT"/>+tinhKhauTruBHXH(luongCoBan)<BR ALIGN="LEFT"/>+tinhKhauTruBHYT(luongCoBan)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  QuyetDinhLuong [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>QuyetDinhLuong</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>SoQD</U> : String<BR ALIGN="LEFT"/>NgayKy : Date<BR ALIGN="LEFT"/>NgayHieuLuc : Date<BR ALIGN="LEFT"/>LuongCoBan : Decimal<BR ALIGN="LEFT"/>PhuCapLuong : Decimal<BR ALIGN="LEFT"/>PhuCapDocHai : Decimal<BR ALIGN="LEFT"/>NguoiKy : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+lapQuyetDinh()<BR ALIGN="LEFT"/>+layHienHanh(maNV, ngay)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  QuyetDinhChucVu [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>QuyetDinhChucVu</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>SoQD</U> : String<BR ALIGN="LEFT"/>NgayKy : Date<BR ALIGN="LEFT"/>NgayHieuLuc : Date<BR ALIGN="LEFT"/>PhuCapChucVu : Decimal<BR ALIGN="LEFT"/>NguoiKy : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+lapQuyetDinh()<BR ALIGN="LEFT"/>+layHienHanh(maNV, ngay)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  {rank=same; PhongBan; ChucVu;}
  {rank=same; NhanVien;}
  {rank=same; QuyetDinhTuyenDung; QuyetDinhLuong; QuyetDinhChucVu;}
  {rank=same; HopDongLaoDong;}
  {rank=same; HoSoBaoHiem;}
  PhongBan -> NhanVien [arrowhead=vee, taillabel="0..1", headlabel="0..*", label="thuộc"];
  NhanVien -> QuyetDinhTuyenDung [arrowhead=vee, taillabel="1", headlabel="0..*", label="được tuyển"];
  PhongBan -> QuyetDinhTuyenDung [arrowhead=vee, taillabel="1", headlabel="0..*", label="thử việc tại"];
  QuyetDinhTuyenDung -> HopDongLaoDong [arrowhead=vee, taillabel="1", headlabel="0..1", label="dẫn tới"];
  HopDongLaoDong -> HoSoBaoHiem [arrowhead=vee, taillabel="1", headlabel="0..1", label="phát sinh"];
  NhanVien -> QuyetDinhLuong [arrowhead=vee, taillabel="1", headlabel="0..*", label="nhận"];
  NhanVien -> QuyetDinhChucVu [arrowhead=vee, taillabel="1", headlabel="0..*", label="nhận"];
  ChucVu -> QuyetDinhChucVu [arrowhead=vee, taillabel="1", headlabel="0..*", label=""];
}
