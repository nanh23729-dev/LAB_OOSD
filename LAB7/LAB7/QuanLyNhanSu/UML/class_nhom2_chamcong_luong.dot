digraph G {
  graph [fontname="Liberation Serif", bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.75, splines=true , rankdir=TB];
  node  [fontname="Liberation Serif", fontsize=11, shape=plaintext, color="#990033"];
  edge  [fontname="Liberation Serif", fontsize=10, color="#990033", fontcolor="#111111", arrowsize=0.8];
  PhongBan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>PhongBan</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaPB</U> : String<BR ALIGN="LEFT"/>TenPB : String<BR ALIGN="LEFT"/>LoaiDonVi : String<BR ALIGN="LEFT"/>DienThoai : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+themPhongBan()<BR ALIGN="LEFT"/>+capNhatPhongBan()<BR ALIGN="LEFT"/>+xoaPhongBan()<BR ALIGN="LEFT"/>+layDanhSach()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  NhanVien [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>NhanVien</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaNV</U> : String<BR ALIGN="LEFT"/>HoTen : String<BR ALIGN="LEFT"/>GioiTinh : String<BR ALIGN="LEFT"/>NgaySinh : Date<BR ALIGN="LEFT"/>CCCD : String<BR ALIGN="LEFT"/>DiaChi : String<BR ALIGN="LEFT"/>DienThoai : String<BR ALIGN="LEFT"/>TrangThai : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+themHoSo()<BR ALIGN="LEFT"/>+capNhatHoSo()<BR ALIGN="LEFT"/>+timKiem(tuKhoa)<BR ALIGN="LEFT"/>+chuyenTrangThai(trangThaiMoi)<BR ALIGN="LEFT"/>+layDangLamViec()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CaLamViec [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>CaLamViec</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaCa</U> : String<BR ALIGN="LEFT"/>TenCa : String<BR ALIGN="LEFT"/>GioBatDau : Time<BR ALIGN="LEFT"/>GioKetThuc : Time<BR ALIGN="LEFT"/>SoGio : Decimal<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+themCa()<BR ALIGN="LEFT"/>+capNhatCa()<BR ALIGN="LEFT"/>+tinhSoGio()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  KeHoachPhanCong [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>KeHoachPhanCong</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaKH</U> : String<BR ALIGN="LEFT"/>TuNgay : Date<BR ALIGN="LEFT"/>DenNgay : Date<BR ALIGN="LEFT"/>NgayLap : Date<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+lapKeHoach()<BR ALIGN="LEFT"/>+layTheoPhongBan(maPB)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ChiTietPhanCong [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>ChiTietPhanCong</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>NgayLam</U> : Date<BR ALIGN="LEFT"/>GioPhuTroiDuKien : Decimal<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+themPhanCong()<BR ALIGN="LEFT"/>+xoaPhanCong()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  BangChamCong [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>BangChamCong</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaBCC</U> : String<BR ALIGN="LEFT"/>Thang : Integer<BR ALIGN="LEFT"/>Nam : Integer<BR ALIGN="LEFT"/>NgayLap : Date<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+moBangChamCong()<BR ALIGN="LEFT"/>+layChiTiet()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ChiTietChamCong [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>ChiTietChamCong</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">SoNgayCong : Decimal<BR ALIGN="LEFT"/>SoNgayNghiPhep : Decimal<BR ALIGN="LEFT"/>SoNgayNghiKhongPhep : Decimal<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+luuChamCong()<BR ALIGN="LEFT"/>+kiemTraTongNgay()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PhieuPhuTroi [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>PhieuPhuTroi</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>SoPhieu</U> : String<BR ALIGN="LEFT"/>NgayPhuTroi : Date<BR ALIGN="LEFT"/>SoGioPhuTroi : Decimal<BR ALIGN="LEFT"/>HinhThuc : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+lapPhieu()<BR ALIGN="LEFT"/>+themNhanVien(maNV, soGio)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ChiTietPhuTroi [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>ChiTietPhuTroi</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">SoGio : Decimal<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+tinhTienPhuTroi(donGiaGio)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  BangLuong [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#990033"><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" CELLPADDING="4"><B>BangLuong</B></TD></TR><TR><TD BGCOLOR="#FFFFCC" BORDER="1" SIDES="B" COLOR="#990033" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4"><U>MaBL</U> : String<BR ALIGN="LEFT"/>Thang : Integer<BR ALIGN="LEFT"/>Nam : Integer<BR ALIGN="LEFT"/>LuongCoBan : Decimal<BR ALIGN="LEFT"/>PhuCapChucVu : Decimal<BR ALIGN="LEFT"/>PhuCapLuong : Decimal<BR ALIGN="LEFT"/>PhuCapDocHai : Decimal<BR ALIGN="LEFT"/>SoNgayCong : Decimal<BR ALIGN="LEFT"/>TienNgayCong : Decimal<BR ALIGN="LEFT"/>SoGioPhuTroi : Decimal<BR ALIGN="LEFT"/>TienPhuTroi : Decimal<BR ALIGN="LEFT"/>TienThuong : Decimal<BR ALIGN="LEFT"/>TienPhat : Decimal<BR ALIGN="LEFT"/>TruBHXH : Decimal<BR ALIGN="LEFT"/>TruBHYT : Decimal<BR ALIGN="LEFT"/>ThucLinh : Decimal<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#FFFFCC" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="4">+tinhBangLuong(thang, nam)<BR ALIGN="LEFT"/>+tinhThucLinh()<BR ALIGN="LEFT"/>+xemBangLuong(thang, nam)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  {rank=same; PhongBan; CaLamViec;}
  {rank=same; NhanVien; KeHoachPhanCong; BangChamCong; PhieuPhuTroi;}
  {rank=same; ChiTietPhanCong; ChiTietChamCong; ChiTietPhuTroi; BangLuong;}
  PhongBan -> NhanVien [arrowhead=vee, taillabel="0..1", headlabel="0..*", label="thuộc"];
  PhongBan -> KeHoachPhanCong [arrowhead=vee, taillabel="1", headlabel="0..*", label="lập"];
  KeHoachPhanCong -> ChiTietPhanCong [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1..*", label=""];
  NhanVien -> ChiTietPhanCong [arrowhead=vee, taillabel="1", headlabel="0..*", label=""];
  CaLamViec -> ChiTietPhanCong [arrowhead=vee, taillabel="1", headlabel="0..*", label=""];
  PhongBan -> BangChamCong [arrowhead=vee, taillabel="1", headlabel="0..*", label=""];
  BangChamCong -> ChiTietChamCong [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1..*", label=""];
  NhanVien -> ChiTietChamCong [arrowhead=vee, taillabel="1", headlabel="0..*", label=""];
  PhieuPhuTroi -> ChiTietPhuTroi [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1..*", label=""];
  NhanVien -> ChiTietPhuTroi [arrowhead=vee, taillabel="1", headlabel="0..*", label=""];
  NhanVien -> BangLuong [arrowhead=vee, taillabel="1", headlabel="0..*", label="hưởng"];
}
